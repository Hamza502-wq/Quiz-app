# docker compose settings (copy to .env). Generate secrets with: openssl rand -hex 32
JWT_ACCESS_SECRET=
OTP_SECRET=

# development = OTP codes returned by the API + simulated Paynow. Use production for real deployments.
API_NODE_ENV=development
OTP_DEV_ECHO=true
PAYMENTS_MOCK=true

# Public URLs
PUBLIC_API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Google Maps
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
GOOGLE_MAPS_SERVER_KEY=

# SMS / WhatsApp (console or twilio)
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# Paynow
PAYNOW_USD_INTEGRATION_ID=
PAYNOW_USD_INTEGRATION_KEY=
PAYNOW_ZWG_INTEGRATION_ID=
PAYNOW_ZWG_INTEGRATION_KEY=
PAYNOW_AUTH_EMAIL=

# Firebase Cloud Messaging (service account)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
