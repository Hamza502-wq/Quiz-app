# DoorStep API base URL (no trailing slash). Add this site's origin to the API's CORS_ORIGINS.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Google Maps JavaScript API key (restrict it to this site's domain)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID for Advanced Markers (create one in Google Cloud console; DEMO_MAP_ID works for development)
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
