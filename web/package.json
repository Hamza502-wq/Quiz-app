{
  "name": "doorstep-web",
  "private": true,
  "workspaces": [
    "shared",
    "vendor-dashboard",
    "admin-panel",
    "customer-web"
  ],
  "scripts": {
    "dev:vendor": "npm run dev -w @doorstep/vendor-dashboard",
    "dev:admin": "npm run dev -w @doorstep/admin-panel",
    "dev:customer": "npm run dev -w @doorstep/customer-web",
    "build": "npm run build -w @doorstep/vendor-dashboard && npm run build -w @doorstep/admin-panel && npm run build -w @doorstep/customer-web",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
