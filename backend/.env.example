# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Number of reverse proxies in front of the API (for correct client IPs / rate limiting)
TRUST_PROXY=0
# Public URL of this API (used for upload URLs and Paynow callbacks — must be reachable by Paynow in production)
PUBLIC_BASE_URL=http://localhost:4000
# Comma-separated browser origins allowed to call the API (vendor dashboard, admin panel)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# ─── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/doorstep?schema=public

# ─── Auth (generate with: openssl rand -hex 32) ───────────
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
OTP_SECRET=change-me-to-another-long-random-string-32-chars
# Hosts with only DATABASE_URL configured: derive missing JWT/OTP secrets from it
# SECRETS_FROM_DATABASE_URL=false
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# Development only: return the OTP in the API response (refused when NODE_ENV=production)
OTP_DEV_ECHO=true

# ─── SMS / WhatsApp (console logs messages; twilio sends them) ───
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# ─── Push notifications (Firebase service account) ────────
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# Paste the private key with literal \n for newlines
FCM_PRIVATE_KEY=

# ─── Paynow Zimbabwe (one integration per currency) ───────
PAYNOW_USD_INTEGRATION_ID=
PAYNOW_USD_INTEGRATION_KEY=
PAYNOW_ZWG_INTEGRATION_ID=
PAYNOW_ZWG_INTEGRATION_KEY=
# Merchant email registered on Paynow (required; used as authemail in test mode)
PAYNOW_AUTH_EMAIL=
# Where the browser returns after a card checkout (defaults to the API's /api/v1/payments/return page)
PAYNOW_RETURN_URL=
# Development only: simulate Paynow (payments auto-confirm after ~5 seconds)
PAYMENTS_MOCK=true
# Allow simulated payments with NODE_ENV=production until Paynow is set up (the apps label them as test payments)
# ALLOW_PAYMENTS_MOCK_IN_PRODUCTION=false

# ─── Google Maps (server key for Distance Matrix; optional) ───
GOOGLE_MAPS_SERVER_KEY=

# ─── Uploads ──────────────────────────────────────────────
# disk (UPLOAD_DIR) or database (hosts without a persistent disk, e.g. Netlify Functions)
UPLOAD_STORAGE=disk
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8

# ─── Background jobs (enable on exactly one instance) ─────
ENABLE_JOBS=true

# ─── Seed ─────────────────────────────────────────────────
SEED_ADMIN_PHONE=+263770000001
SEED_ADMIN_PASSWORD=DoorStep@2026
